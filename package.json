{
  "name": "@seventhingscompany/n8n-nodes-seventhings",
  "version": "0.1.2",
  "description": "n8n community node for seventhings: manage assets, tasks, rental cases, locations, rooms and files.",
  "license": "MIT",
  "homepage": "https://seventhings.com",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "seventhings",
    "asset-management",
    "inventory"
  ],
  "author": { "name": "Henry Rausch", "email": "office@seventhings.com" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seventhingscompany/n8n-nodes-seventhings.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/SeventhingsApi.credentials.js"],
    "nodes": [
      "dist/nodes/Seventhings/Seventhings.node.js",
      "dist/nodes/SeventhingsTrigger/SeventhingsTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^20.19.0",
    "eslint": "9.29.0",
    "n8n-workflow": "*",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
